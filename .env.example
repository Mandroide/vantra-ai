# DEMO: ejecución determinista sin claves (solo texto, TTS local opcional).
# LIVE: Claude + Deepgram + Azure Speech, necesita las claves correspondientes.
VANTRA_MODE=DEMO
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_VOICE=es-DO-RamonaNeural
ENABLE_LOCAL_TTS=false
# Precios ilustrativos configurables; 0 = no se dispone de tarifa confirmada.
LLM_INPUT_USD_PER_MILLION=0
LLM_OUTPUT_USD_PER_MILLION=0
DEEPGRAM_USD_PER_MINUTE=0
AZURE_USD_PER_MILLION_CHARACTERS=0

# TELEFONÍA REAL: PILOTO MANUAL Y RESTRINGIDO; DESACTIVADO POR DEFECTO
# Solo para probar manualmente fuera de horario con números autorizados; false por defecto.
TWILIO_ALLOW_AFTER_HOURS_TEST_CALLS=false
# Conteo de intentos (incluye fallos del proveedor); valores aceptados 1..10
TWILIO_DAILY_CALL_LIMIT=3
TWILIO_CALLS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Dominio https publico/tunnel que termina en el servidor FastAPI local :8000
TWILIO_PUBLIC_BASE_URL=
# Lista de destinatarios con consentimiento documentado, separada por comas (solo DO).
TWILIO_TEST_NUMBERS=

# CONECTIVIDAD: ngrok (predeterminado), cloudflare o direct
# Esta opción la utiliza scripts/connectivity.py, no la aplicación de telefonía.
CONNECTIVITY_PROVIDER=ngrok
# ngrok: URL HTTPS del dominio de desarrollo reservado en su cuenta
NGROK_AUTHTOKEN=
# Cloudflare: túnel remoto y hostname público configurado en el panel
CLOUDFLARE_TUNNEL_TOKEN=
# DIRECTO: hostname DNS público y correo TLS para Caddy (sin https://)
VANTRA_PUBLIC_HOST=
CADDY_EMAIL=
