# Git attributes for Vantra AI (Linux/Docker, Windows/PyCharm).
# Normalize detected text files and never rewrite binary data.
* text=auto

# Consistent LF for Python, configuration, docs, datasets and shell scripts.
*.py          text eol=lf
*.pyi         text eol=lf
*.sh          text eol=lf
*.md          text eol=lf
*.rst         text eol=lf
*.txt         text eol=lf
*.csv         text eol=lf
*.json        text eol=lf
*.jsonl       text eol=lf
*.toml        text eol=lf
*.lock        text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.ini         text eol=lf
*.cfg         text eol=lf
*.xml         text eol=lf
*.html        text eol=lf
*.css         text eol=lf
*.js          text eol=lf
*.sql         text eol=lf
*.env.example text eol=lf
Dockerfile    text eol=lf
Caddyfile     text eol=lf
.gitattributes text eol=lf
.gitignore    text eol=lf
.dockerignore text eol=lf
.pre-commit-config.yaml text eol=lf

# Native Windows command files use CRLF when checked out.
*.bat         text eol=crlf
*.cmd         text eol=crlf
*.ps1         text eol=crlf

# Audio, media, documents and compiled artifacts must remain binary.
*.wav         binary
*.ogg         binary
*.mp3         binary
*.mp4         binary
*.flac        binary
*.png         binary
*.jpg         binary
*.jpeg        binary
*.gif         binary
*.webp        binary
*.ico         binary
*.pdf         binary
*.docx        binary
*.pptx        binary
*.xlsx        binary
*.zip         binary
*.gz          binary
*.db          binary
*.sqlite      binary
*.sqlite3     binary
*.parquet     binary
*.pkl         binary
*.onnx        binary
*.pyc         binary
